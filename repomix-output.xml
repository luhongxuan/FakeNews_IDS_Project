.dashboard { position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; background-color: #131314; color: #E3E3E3; font-family: system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; }

