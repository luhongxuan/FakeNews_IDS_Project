/* 🌟 新增：空白初始狀態下的「骨架卡片佔位屏」動畫樣式表 */
.skeletonCard {
  background-color: #1E1F22;
  border: 1px solid rgba(60, 64, 67, 0.3);
  border-radius: 8px;
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  pointer-events: none;
}

.skeletonHeader { display: flex; justify-content: space-between; align-items: center; }

.skeletonTitle {
  width: 200px; height: 14px;
  background: linear-gradient(90deg, #282A2C 25%, #313335 50%, #282A2C 75%);
  background-size: 200% 100%;
  animation: loadingShimmer 1.5s infinite linear;
  border-radius: 4px;
}

.skeletonDate { width: 70px; height: 11px; background-color: #282A2C; border-radius: 3px; }
.skeletonBody { display: flex; flex-direction: column; gap: 12px; }
.skeletonBadge { width: 120px; height: 20px; background-color: rgba(253, 214, 99, 0.03); border: 1px solid rgba(253, 214, 99, 0.05); border-radius: 4px; }

.skeletonLine {
  width: 95%; height: 12px;
  background: linear-gradient(90deg, #282A2C 25%, #313335 50%, #282A2C 75%);
  background-size: 200% 100%;
  animation: loadingShimmer 1.5s infinite linear;
  border-radius: 4px;
}

.skeletonLineShort { composes: skeletonLine; width: 60%; }

@keyframes loadingShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
