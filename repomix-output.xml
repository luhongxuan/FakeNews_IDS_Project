.cardList { display: flex; flex-direction: column; gap: 14px; }
.eventCard { background-color: #1E1F22; border: 1px solid #3C4043; border-radius: 8px; padding: 20px 24px; cursor: pointer; display: flex; flex-direction: column; gap: 12px; transition: background-color 0.15s, border-color 0.15s, transform 0.15s; }
